# --- Requeridas ---
# Conexión a Postgres. En Neon: copiar la "connection string" (incluye ?sslmode=require).
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/gescom

# Clave para firmar los JWT. Generar una propia:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambia-esto-por-una-clave-segura

# --- Opcionales (defaults pensados para desarrollo local) ---
# Duración del token en minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Orígenes permitidos para CORS, separados por coma.
# En producción: la URL del frontend en Vercel.
CORS_ORIGINS=http://localhost:5173

# Swagger/ReDoc (/docs, /redoc). Poner en false en producción.
DOCS_ENABLED=true

# Rate limit de login.
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=15
