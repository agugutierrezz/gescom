# --- Requeridas ---
# Conexión a Postgres. En Neon: copiar la "connection string" (incluye ?sslmode=require).
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/gescom

# Clave para firmar los JWT. Generar una propia:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambia-esto-por-una-clave-segura

# --- Opcionales (defaults pensados para desarrollo local) ---
# Duración del token en minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Orígenes permitidos para CORS, separados por coma.
# En producción: la URL del frontend en Vercel.
CORS_ORIGINS=http://localhost:5173

# Swagger/ReDoc (/docs, /redoc). Poner en false en producción.
DOCS_ENABLED=true

# Rate limit de login.
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=15

# Branding del comprobante de reserva (opcional), en JSON y en UNA sola línea.
# Clave = nombre de usuario del complejo. Sin esta variable, el comprobante
# sale con el logo de GESCOM. En el .env va entre comillas simples.
#   "logo": ruta relativa a app/assets (el archivo no se sube al repo).
#   "logo_base64": alternativa para producción (PNG en base64), p. ej. con
#       python -c "import base64;print(base64.b64encode(open('logo.png','rb').read()).decode())"
# BRANDING_COMPLEJOS='{"usuario": {"nombre": "Mi Complejo", "direccion": "Calle 123", "ciudad": "Ciudad, Provincia", "cp": "B0000", "logo": "complejos/usuario/logo.png"}}'
BRANDING_COMPLEJOS=
